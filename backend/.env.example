APP_ENV=development

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/dental_oasis
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dental_oasis
DB_USER=root
DB_PASSWORD=password

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# CORS
CORS_ORIGINS=http://localhost:5173

# Clinic Info
CLINIC_NAME=Dental Oasis
CLINIC_ADDRESS=270 Block E2, Johar Town, Lahore
CLINIC_PHONE=
CLINIC_WHATSAPP=
CLINIC_EMAIL=
CLINIC_GOOGLE_MAPS_URL=https://maps.google.com/?q=270+Block+E2+Johar+Town+Lahore
CLINIC_TIMEZONE=Asia/Karachi
CLINIC_OPEN_TIME=17:00
CLINIC_CLOSE_TIME=21:00
